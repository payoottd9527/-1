def create_card_for_user(user_info, card_params):
    # 1. 创建客户
    client = requests.post("https://api.photonpay.com/v1/clients", 
                          json={"name": user_info.name, "email": user_info.email})
    
    # 2. 建立账户协议
    account = requests.post("https://api.photonpay.com/v1/accounts",
                           json={"client_id": client.id, "currency": "USD"})
    
    # 3. 开通虚拟卡
    card = requests.post("https://api.photonpay.com/v1/cards",
                        json={"account_id": account.id, 
                              "type": "virtual",
                              "limit": 5000})
    
    # 4. 返回卡片信息（注意加密存储）
    return {"card_id": card.id, "last4": card.last4}
